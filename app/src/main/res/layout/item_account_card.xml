<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="16dp"
    android:elevation="2dp">

    <!-- Header: Name & Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        
        <EditText
            android:id="@+id/etItemName"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="계정 이름 입력"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@null" />
            
        <Button
            android:id="@+id/btnItemSaveName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이름 저장"
            android:textSize="12sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="8dp"/>
            
        <ImageButton
            android:id="@+id/btnItemDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="8dp"
            android:tint="#FF5252"
            android:contentDescription="계정 삭제" />
    </LinearLayout>

    <!-- Status & Login -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        
        <TextView
            android:id="@+id/tvItemStatus"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="로그인 안됨" />
            
        <Button
            android:id="@+id/btnItemLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="로그인"
            android:textSize="12sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvItemDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:text="상세 내역 없음"
        android:layout_marginBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        android:layout_marginBottom="12dp" />

    <!-- Notification Display Settings -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="알림창 표시 설정"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>
        
    <CheckBox
        android:id="@+id/cbItemShowCollapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="한줄 알림창 표시 (전체 중 최대 2개)"
        android:textSize="12sp" />
        
    <CheckBox
        android:id="@+id/cbItemShowExpanded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="확장 알림창 표시 (제한 없음)"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/cbItemAlertOnReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="할당량 초기화 시 알림 받기"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="초기화 남은 시간 표시 방식:"
            android:textSize="12sp"/>
        <Spinner
            android:id="@+id/spinnerResetTimeMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Alerts Settings -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="할당량 경고 설정"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:id="@+id/llAlertsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnAddAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ 알림 규칙 추가"
        android:textSize="12sp"
        android:minHeight="0dp"
        android:padding="8dp"
        android:layout_marginBottom="8dp"/>
    
    <Button
        android:id="@+id/btnItemSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="설정 저장 (표시 여부 및 경고 기준)"
        android:layout_marginTop="8dp"/>

</LinearLayout>
